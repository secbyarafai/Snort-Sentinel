# =============================================================
#  Snort Sentinel - custom detection rules
#  Location on the IDS: /etc/snort/rules/local.rules
#  Custom rules use SIDs of 1,000,000 and above (lower SIDs are
#  reserved for official Snort/community rules).
# =============================================================

# Detect ICMP pings (echo requests) into the lab network
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Detected"; itype:8; sid:1000001; rev:2;)

# Detect Nmap SYN (half-open) scans
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN scan detected"; flags:S; sid:1000002; rev:2;)
